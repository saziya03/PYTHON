   "source": [
    "Q1. Reverse a string without using a built-in reverse function."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "22d9d22b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "nohtyp\n"
     ]
    }
   ],
   "source": [
    "name = \"python\"\n",
    "s = name[ :: -1]\n",
    "print(s)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "6383a4ff",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "nohtyp\n"
     ]
    }
   ],
   "source": [
    "# USING A FOR LOOP\n",
    "name = \"python\"\n",
    "rev = \"\"\n",
    "\n",
    "for char in name:\n",
    "    rev = char + rev\n",
    "print(rev)"
   ]
  }
